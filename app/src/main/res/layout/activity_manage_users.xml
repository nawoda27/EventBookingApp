<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F6F8FC">


    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="USER MANAGEMENT"

            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold"

            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Manage Users"

            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="View and manage registered platform users"

            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- User Management Info Card -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="82dp"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"

        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#2563EB">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- Icon -->

            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="46dp"

                android:gravity="center"

                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="U"

                    android:textColor="#2563EB"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Text -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"

                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Registered Users"

                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Manage accounts and user information"

                    android:textColor="#DBEAFE"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Section Title -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"

        android:layout_marginTop="23dp"
        android:layout_marginBottom="10dp"

        android:text="ALL USERS"

        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold"

        android:letterSpacing="0.15" />


    <!-- Users List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="25dp"

        android:clipToPadding="false" />

</LinearLayout>